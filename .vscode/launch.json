  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Dev Server",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "netlify",
      "runtimeArgs": ["dev", "--debug"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Start Storybook",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["start-storybook"],
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Start Dev Server", "Start Storybook"]
    }
  ]
}
